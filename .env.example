# Copy to .env and fill in. Never commit .env.

# Public hostname Caddy gets an HTTPS certificate for (an A record pointing at the server).
API_DOMAIN=api.example.com

POSTGRES_PASSWORD=change-me
# Inside docker compose the backend reaches Postgres at host "db".
DATABASE_URL=postgresql+psycopg://forecast:change-me@db:5432/forecast

# At least 32 random characters: `openssl rand -hex 32`
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ALLOW_SELF_REGISTRATION=true

# Shared secret between the backend and the ML service: `openssl rand -hex 24`
ML_SERVICE_TOKEN=
ML_SERVICE_URL=http://ml:8100

# Path to the ML engine repository (built into the ml image).
MLENGINE_PATH=../SemProject_MLEngine
